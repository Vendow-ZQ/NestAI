{
  "name": "nestai-webapp",
  "version": "2.0.0",
  "private": true,
  "description": "NestAI Web Application (Vite + React + FastAPI)",
  "scripts": {
    "dev": "python run.py",
    "dev:web": "pnpm --dir web dev",
    "dev:server": "cd python-server && python -m uvicorn app.main:app --reload --port 8000 --host 0.0.0.0",
    "build": "pnpm build:web && pnpm check:server",
    "build:web": "pnpm --dir web build",
    "check:server": "cd python-server && python -m compileall app",
    "preview": "pnpm --dir web preview",
    "start": "cd python-server && python -m uvicorn app.main:app --port 8000 --host 0.0.0.0",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
