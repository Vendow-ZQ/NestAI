{
  "name": "nestai-webapp",
  "version": "2.0.0",
  "private": true,
  "description": "NestAI Web Application (Vite + React + Express)",
  "scripts": {
    "dev": "pnpm exec concurrently --kill-others --kill-signal SIGKILL -n web,server -c blue,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "cd web && pnpm dev",
    "dev:server": "cd web-server && pnpm dev",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "cd web && pnpm build",
    "build:server": "cd web-server && pnpm build",
    "preview": "cd web && pnpm preview",
    "start": "cd web-server && pnpm start",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
