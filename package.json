{
  "name": "nestai-webapp",
  "version": "2.0.0",
  "private": true,
  "description": "NestAI Web Application (Vite + React + FastAPI)",
  "scripts": {
    "dev": "python run.py",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000 --host 0.0.0.0",
    "build": "pnpm build:frontend && pnpm check:backend",
    "build:frontend": "pnpm --dir frontend build",
    "check:backend": "python scripts/check_backend_syntax.py backend/app",
    "preview": "pnpm --dir frontend preview",
    "start": "cd backend && python -m uvicorn app.main:app --port 8000 --host 0.0.0.0",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
