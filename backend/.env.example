# LLM API配置（参考api_test/test.py格式）
# 支持多个API，格式: XXX_API_KEY + XXX_BASE_URL + XXX_MODELS + XXX_TYPE

# Anthropic Claude配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODELS=claude-sonnet-4-5,claude-haiku-4-5
ANTHROPIC_TYPE=anthropic

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o,gpt-4o-mini
OPENAI_TYPE=openai

# 其他兼容OpenAI的API（如DeepSeek、SiliconFlow等）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-chat,deepseek-coder
DEEPSEEK_TYPE=openai

# 应用配置
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# 数据库
DATABASE_URL=sqlite:///./nestai.db

# 上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# Cloud deployment
# Use a Supabase Postgres connection string. Prefer the Supabase pooler URL for hosted apps.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Public URL of the Render backend, used when returning image URLs to Vercel.
# Example: https://nestai-api.onrender.com
PUBLIC_BASE_URL=

# Comma-separated frontend origins allowed by the API.
# Example: https://nestai.vercel.app,http://localhost:5000
CORS_ORIGINS=*

# Storage backend: local, supabase, or auto.
STORAGE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nestai-uploads
